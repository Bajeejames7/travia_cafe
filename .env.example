# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=production
# Your public address, used in emails (e.g. https://traviacafe.co.ke)
PUBLIC_URL=http://localhost:3000

# Secret address of the staff dashboard. Pick something hard to guess.
# With "hq-7f3k" the dashboard is at https://yoursite/hq-7f3k — /staff and /admin will 404.
STAFF_PATH=hq-change-me

# First admin account (only used the first time the server starts).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-long-password

# Database. Leave DATABASE_URL empty to use a local SQLite file in DATA_DIR (great for previews).
# Production: the Aiven PostgreSQL "Service URI", plus the CA certificate from the Aiven console.
DATABASE_URL=
DATABASE_CA_CERT=

# Local files: the SQLite database (if used) and, unless S3_BUCKET is set, uploaded videos.
DATA_DIR=./data
MAX_VIDEO_MB=2048

# Video storage in an S3-compatible bucket, e.g. Backblaze B2 (10 GB free, no card). Needed on hosts without a
# persistent disk, such as Render's free plan, where files on the server are wiped on every restart.
# Leave S3_BUCKET empty to keep videos in DATA_DIR/videos.
S3_ENDPOINT=
S3_BUCKET=
S3_KEY_ID=
S3_SECRET=

# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx).
TRUST_PROXY=1

# Student accounts: how many devices one account can be signed in on at once.
MAX_STUDENT_DEVICES=2

# "Continue with Google" (optional). Leave empty to hide the button.
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# Authorised redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo accounts created by `npm run seed` (local previews only). Random passwords are printed if empty.
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_PASSWORD=

# M-PESA prompt (STK push) through PayHero (https://payherokenya.com). Leave empty to turn it off;
# students then pay from the M-PESA menu and type the code, and an admin confirms it.
# PAYHERO_AUTH: PayHero dashboard > API Keys > the "Basic Authorization" token.
# PAYHERO_CHANNEL_ID: PayHero dashboard > Payment Channels > My Payment Channels.
# PayHero calls back to <PUBLIC_URL>/payhero/callback, so PUBLIC_URL must be the public https address.
PAYHERO_AUTH=
PAYHERO_CHANNEL_ID=

# Email. Leave both options empty and emails are only saved in the dashboard's Emails tab.
# Option 1, Brevo's web API (300 emails a day free). Works on Render's free plan, which blocks SMTP.
BREVO_API_KEY=
# Option 2, any SMTP server (Gmail: smtp.gmail.com, port 465, and an App Password), on hosts that allow SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender (with Brevo, it must be a sender or domain verified in Brevo) and where replies go.
MAIL_FROM="Travia Cafe <you@example.com>"
MAIL_REPLY_TO=
