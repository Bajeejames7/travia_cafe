# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=production
# Your public address, used in emails (e.g. https://traviacafe.co.ke)
PUBLIC_URL=http://localhost:3000

# Secret address of the staff dashboard. Pick something hard to guess.
# With "hq-7f3k" the dashboard is at https://yoursite/hq-7f3k — /staff and /admin will 404.
STAFF_PATH=hq-change-me

# First admin account (only used the first time the server starts).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-long-password

# Database. Leave DATABASE_URL empty to use a local SQLite file in DATA_DIR (great for previews).
# Production: the Aiven PostgreSQL "Service URI", plus the CA certificate from the Aiven console.
DATABASE_URL=
DATABASE_CA_CERT=

# Uploaded videos (and the SQLite file, if used) are stored here. Must be a persistent disk in production.
DATA_DIR=./data
MAX_VIDEO_MB=2048

# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx).
TRUST_PROXY=1

# Student accounts: how many devices one account can be signed in on at once.
MAX_STUDENT_DEVICES=2

# "Continue with Google" (optional). Leave empty to hide the button.
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# Authorised redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo accounts created by `npm run seed` (local previews only). Random passwords are printed if empty.
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_PASSWORD=

# Email (any SMTP provider). Gmail: smtp.gmail.com, port 465, and an App Password.
# Leave SMTP_HOST empty and emails are only saved in the dashboard's Emails tab.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Travia Cafe <you@example.com>"
